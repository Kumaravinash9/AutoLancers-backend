# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/automatelancers

# --- Freelancer.com OAuth app ---
# Create at https://accounts.freelancer.com/settings/develop (log in first).
# Optional: discovery works unauthenticated, a token just gives richer data and higher limits.
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the app
FREELANCER_REDIRECT_URI=http://localhost:8010/auth/freelancer/callback

# --- Token encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Sessions ---
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_TTL_HOURS=336
# Set true when serving over HTTPS
COOKIE_SECURE=false

# --- Proposal drafting ---
# Which LLM writes the proposals: gemini | anthropic
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
POLL_INTERVAL_SECONDS=25
# Set false to run the API without the background poller (useful in tests/dev)
SCHEDULER_ENABLED=true
