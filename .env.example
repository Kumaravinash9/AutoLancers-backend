# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/automatelancers

# --- Freelancer.com OAuth app ---
# Create at https://accounts.freelancer.com/settings/develop (log in first).
# Optional: discovery works unauthenticated, a token just gives richer data and higher limits.
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=
# Must exactly match the redirect URI registered on the app
FREELANCER_REDIRECT_URI=http://localhost:8010/auth/freelancer/callback

# --- Token encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Sessions ---
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
SESSION_TTL_HOURS=336
# Lifetime of the JWT the app hands the browser extension. Short by design — re-minted on each
# connect/sign-in — so a token lifted off a machine expires on its own.
EXTENSION_TOKEN_TTL_HOURS=12
# Set true when serving over HTTPS
COOKIE_SECURE=false
# The account the poller and CLI scripts act as — requests carry their own identity, so this only
# covers the paths with no signed-in user. Point it at the account that owns the connected
# marketplace profiles, or discovery polls an empty profile and finds nothing.
DEFAULT_USER_EMAIL=owner@localhost

# --- Proposal drafting ---
# Which LLM writes the proposals: gemini | anthropic
LLM_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- App ---
FRONTEND_ORIGIN=http://localhost:3000
POLL_INTERVAL_SECONDS=1800
# Set false to run the API without the background poller (useful in tests/dev)
SCHEDULER_ENABLED=true

# --- OpenAI-compatible provider (LLM_PROVIDER=nvidia) ---
# Any endpoint speaking the OpenAI chat API: NVIDIA NIM, a self-hosted vLLM, an aggregator.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
